{
  "schemaVersion": 1,
  "id": "post_effects",
  "version": "${version}",
  "name": "Shader2Post",
  "description": "A mod that lets you turn shaders into Minecraft post effects",
  "authors": ["EnderX"],
  "contact": {},
  "license": "LGPL-3.0",
  "icon": "assets/post_effects/icon.png",
  "environment": "*",
  "entrypoints": {
    "client": [
      "com.enderx.posteffect.post_effects.client.Post_effectsClient"
    ]
  },

  "mixins": [
    "post_effects.mixins.json",
    {
      "config": "post_effects.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric-api": "*",
    "minecraft": "${minecraft_version}"
  }
}
